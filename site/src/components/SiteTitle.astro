---
// Starlight's logo and name, followed by a Docs link to the first guide.
import Default from '@astrojs/starlight/components/SiteTitle.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const inDocs = Astro.locals.starlightRoute.entry.data.template !== 'splash';
---

<div class="og-title">
  <Default />
  <a class="og-nav-link" href={`${base}/configuration/`} aria-current={inDocs ? 'page' : undefined}>Docs</a>
</div>

<style>
  .og-title {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-width: 0;
  }
  .og-nav-link {
    padding: 0.25rem 0;
    font-size: var(--sl-text-sm);
    font-weight: 500;
    color: var(--sl-color-gray-3);
    text-decoration: none;
    white-space: nowrap;
  }
  .og-nav-link:hover { color: var(--sl-color-white); }
  .og-nav-link[aria-current='page'] {
    color: var(--sl-color-white);
    box-shadow: inset 0 -2px 0 var(--sl-color-accent);
  }
</style>
